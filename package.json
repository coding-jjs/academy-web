{
    "name": "academy-web-v2",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev -p 3000",
        "build": "next build",
        "start": "next start -p 3000",
        "lint": "eslint",
        "typecheck": "tsc --noEmit",
        "validate": "npm run lint && npm run typecheck && prisma validate && next build",
        "bootstrap:director": "node --env-file=.env.local scripts/bootstrap-director.mjs",
        "auth:director:test-login": "node --env-file=.env.local scripts/move-director-to-test-login.mjs",
        "db:reset:keep-director": "node --env-file=.env.local scripts/reset-data-keep-director.mjs",
        "db:seed:classes": "node --env-file=.env.local scripts/seed-class-mock-data.mjs",
        "db:seed:test": "node --env-file=.env.local scripts/seed-test-data.mjs",
        "postinstall": "prisma generate"
    },
    "dependencies": {
        "@google/generative-ai": "^0.24.1",
        "@prisma/adapter-pg": "^7.9.1",
        "@prisma/client": "^7.9.1",
        "@supabase/supabase-js": "^2.112.3",
        "@tosspayments/tosspayments-sdk": "^2.7.1",
        "dotenv": "^17.4.2",
        "next": "16.2.12",
        "next-auth": "^5.0.0-beta.32",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "server-only": "^0.0.1"
    },
    "devDependencies": {
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "eslint": "^9",
        "eslint-config-next": "16.2.12",
        "prisma": "^7.9.1",
        "typescript": "^5"
    },
    "overrides": {
        "postcss": "8.5.25",
        "sharp": "0.35.3"
    }
}

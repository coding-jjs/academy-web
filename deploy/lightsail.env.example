# Lightsail / docker compose 용. 서버에서는 이 파일을 academy-web/.env 로 복사한다.
# 로컬 개발은 기존처럼 .env.local 을 쓴다. 이 파일을 커밋하지 말 것.

APP_DOMAIN=academy.example.com
CADDY_EMAIL=admin@example.com

# 앱·OAuth가 쓰는 공개 URL. https 이고 끝 슬래시 없음.
NEXT_PUBLIC_APP_URL=https://academy.example.com

# Lightsail PostgreSQL (권장). 비밀번호에 @/# 있으면 URL 인코딩.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/academy?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/academy?sslmode=require"

# ./deploy/up.sh --bundled-db 로 같은 인스턴스 Postgres를 쓸 때만.
# POSTGRES_PASSWORD=
# DATABASE_URL="postgresql://academy:PASSWORD@postgres:5432/academy"
# DIRECT_URL="postgresql://academy:PASSWORD@postgres:5432/academy"

NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# 넣지 말 것. 코드가 NODE_ENV=production 에서 개발 로그인을 끈다.
# ENABLE_DEV_LOGIN=false

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"

BOOTSTRAP_SECRET=""
